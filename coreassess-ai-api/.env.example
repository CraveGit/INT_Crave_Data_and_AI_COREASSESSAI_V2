# HANA. TABLE_PREFIX: CRA_ = new CAP container, KCC_ = legacy schema
TABLE_PREFIX=CRA_
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASS=
SCHEMA=
# SAP AI Core
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_RESOURCE_GROUP=default
# Global default. A request-level "model" (admin panel) overrides EVERY stage below.
ANALYSIS_MODEL=anthropic--claude-4.8-opus
# Per-stage defaults. Deep reasoning where SAP accuracy matters, cheap models for
# mechanical extraction. Unset = the value shown.
#MODEL_BASIC=anthropic--claude-4.8-opus
#MODEL_S4=anthropic--claude-4.8-opus
#MODEL_TECHNICAL=anthropic--claude-4.8-opus
#MODEL_INTERFACE=gpt-4o
#MODEL_CDS=gpt-4o
#MODEL_RETIRE=gpt-4o
#MODEL_RELIST=gpt-4o-mini
#MODEL_QUALITY=gpt-4o-mini
# grounding MCP + model overrides (optional)
AXIOM_MCP_URL=https://ai-sap-connectors.cfapps.us10-001.hana.ondemand.com/mcp
MODEL_DOCSUITE=gpt-4o
# concurrency: max simultaneous analyses per worker (each fans out ~6 LLM calls)
MAX_CONCURRENT_ANALYSIS=4
# docgen: one LLM call per section (a single call caps out near 1200 words).
# workers = parallel sections; raise max tokens only if sections get truncated.
DOC_SECTION_WORKERS=4
DOC_SECTION_MAX_TOKENS=8000
# effort sizing: hours stay authoritative, person-days are derived from this.
HOURS_PER_PERSON_DAY=8
# logging: always mirrored to stdout for `cf logs`; the file backs GET /logs.
LOG_LEVEL=WARNING
LOG_FILE=Run.log
# protects GET/DELETE /logs and POST /pricing/refresh when set. Set it in CF.
LOG_ADMIN_TOKEN=
# local debugging only: writes enhanced_output.json per analysis. Leave EMPTY on CF.
DEBUG_DUMP_DIR=
