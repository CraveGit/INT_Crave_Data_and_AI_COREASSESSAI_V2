<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout.form"
>
    <Dialog id="addUserDialog" title="{addUserModel>/title}" contentWidth="30rem">
        <content>
            <l:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" columnsXL="1" columnsL="1">
                <Label text="Display Name (optional)"/>
                <Input value="{addUserModel>/displayName}" placeholder="e.g. Jane Doe"/>
                <Label text="Email" required="true"/>
                <Input value="{addUserModel>/email}" type="Email" placeholder="name@company.com" editable="{= !${addUserModel>/isEdit} }"/>
                <Label text="Role" required="true"/>
                <Select selectedKey="{addUserModel>/role}">
                    <core:Item key="USER" text="User"/>
                    <core:Item key="SUPERUSER" text="Superuser"/>
                    <core:Item key="ADMIN" text="Admin" enabled="{= ${visibleModel>/role} === 'OWNER' }"/>
                </Select>
                <Label text="Allowed Uploads"/>
                <Input value="{addUserModel>/allowedObjects}" type="Number" placeholder="100"/>
                <!-- Consumed uploads can only be corrected by an owner, when editing. -->
                <Label text="Consumed Uploads" visible="{= ${addUserModel>/isEdit} &amp;&amp; ${visibleModel>/role} === 'OWNER' }"/>
                <Input value="{addUserModel>/uploadedObjects}" type="Number"
                    visible="{= ${addUserModel>/isEdit} &amp;&amp; ${visibleModel>/role} === 'OWNER' }"/>
                <!-- Company / project scope does not apply to admins/owners: they
                     have access to all companies, so both inputs are disabled when
                     the selected role is ADMIN or OWNER. -->
                <Label text="Companies"/>
                <MultiComboBox selectedKeys="{addUserModel>/companyIDs}" items="{companiesModel>/companies}"
                    placeholder="Select companies" selectionChange="onCompaniesChange" selectionFinish="onCompaniesChange"
                    enabled="{= ${addUserModel>/role} !== 'ADMIN' &amp;&amp; ${addUserModel>/role} !== 'OWNER' }">
                    <core:Item key="{companiesModel>ID}" text="{companiesModel>COMPANY_NAME}"/>
                </MultiComboBox>
                <!-- Access is company-level; projects are read-only, derived from the
                     selected companies. -->
                <Label text="Projects (from companies)"/>
                <TextArea rows="3" width="100%"
                    editable="false"
                    enabled="{= ${addUserModel>/role} !== 'ADMIN' &amp;&amp; ${addUserModel>/role} !== 'OWNER' }"
                    value="{= (${addUserModel>/role} === 'ADMIN' || ${addUserModel>/role} === 'OWNER') ? 'All projects (admin / owner has access to all companies)' : ${addUserModel>/projectsPreview} }"
                    placeholder="Select companies to see their projects"/>
            </l:SimpleForm>
        </content>
        <beginButton>
            <Button text="{addUserModel>/submitText}" type="Emphasized" press="onSubmitAddUser"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCancelAddUser"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
