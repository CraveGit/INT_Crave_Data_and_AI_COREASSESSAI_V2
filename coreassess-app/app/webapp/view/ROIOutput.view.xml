<mvc:View
    controllerName="com.crave.coreassessv2.controller.ROIOutput"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    height="100%"
    id="ROIOutputPage"
>
    <Page
        id="ROIOutput"
        title="{i18n>title}"
        showHeader="false"
    >
        <content>
           
           
                <VBox
                    width="100%"
                    class="sapUiTinyMarginEnd sapUiTinyMarginTop"
                >
                    <Panel
                        width="100%"
                        expandable="false"
                        expanded="true"
                        headerText="ROI Output table"
                    >
                      <VBox
                            class="sapUiSmallMargin"
                            width="400px"
                        >
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="Select Company" />
                            <ComboBox
                                id="ROIOutputPageSelectCompany"
                                width="100%"
                                class="sapUiSmallMarginEnd"
                                change="onCompanyChange"
                                items="{
                path: 'listPageCompanyModel>/companyArray'}"
                            >
                                <core:Item
                                    key="{listPageCompanyModel>ID}"
                                    text="{listPageCompanyModel>COMPANY_NAME}"
                                />
                            </ComboBox>
                        </VBox>

                        <!-- Project Selection -->
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="Select Projects" />
                            <ComboBox
                                id="ROIOutputPageSelectProject"
                                width="100%"
                                class="sapUiSmallMarginEnd"
                                items="{
                                path: 'listPageProjectModel>/projectArray'}"
                                selectionChange="callOutput"
                            >
                                <core:Item
                                    key="{listPageProjectModel>ID}"
                                    text="{listPageProjectModel>PROJECT_NAME}"
                                />
                            </ComboBox>
                        </VBox>
                        </VBox>

                       
                        <content>
                            <t:Table
                             
                                rows="{ROI_Out_Model>/RO_Out}"
                                class="sapUiSmallMarginBottom"
                                visibleRowCount="8"
                                enableColumnFreeze="true"
                                rowSelectionChange="showData"
                                ariaLabelledBy="title"
                                enableSelectAll="false"
                                selectionMode="None" width="1200px" fixedColumnCount="2"
                            >
                                <t:extension>
                                    <OverflowToolbar style="Clear">
                                        <Title text="Business Outcome" />
                                        <ToolbarSpacer />

                                    </OverflowToolbar>
                                </t:extension>
                                <t:columns>
                                   
                                    <t:Column width="14rem">
                                        <Label
                                            text="Business outcomes"
                                            textAlign="Center"
                                        />
                                        <t:template>
                                            <Text
                                                text="{ROI_Out_Model>Business_Outcome}"
                                                wrapping="false"
                                            />
                                        </t:template>
                                    </t:Column>

                                    <t:Column width="344px">
                                        <Label
                                            text="Value Driver"
                                            textAlign="Center"
                                        />
                                        <t:template>
                                            <Text
                                                text="{ROI_Out_Model>Value_Driver}"
                                                wrapping="true"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <!-- <t:Column width="7rem">
                                        <Label
