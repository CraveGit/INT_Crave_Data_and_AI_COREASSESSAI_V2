                                            value="{editselectObjectModel>USE_CASE_AREA}"
                                            class="sapUiTinyMarginEnd"
                                        />
                                    </CustomListItem>
                                </List>
                            </VBox>
                            <VBox
                                class="sapUiSmallMarginBottom"
                                width="50%"
                            >
                                <tnt:InfoLabel
                                    text="Use Case Brief"
                                    colorScheme="6"
                                />
                                <TextArea
                                    value="{editselectObjectModel>/USE_CASE_AREA_EXPLANATION}"
                                    class="sapUiTinyMarginEnd"
                                    growing="true"
                                    width="100%"
                                />
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </Panel>
        <footer>
            <m:OverflowToolbar>
                <m:ToolbarSpacer />
                <Button
                    press="onUpdateObject"
                    type="Accept"
                    text="Apply Changes"
                    class="sapUiTinyMarginEnd"
                />
                <Button
                    press="editFragClose"
                    text="Close"
                />
            </m:OverflowToolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>
