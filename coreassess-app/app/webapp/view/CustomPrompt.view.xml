<mvc:View
    controllerName="com.crave.coreassessv2.controller.CustomPrompt"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core"
   
    id="customPrompt"
>
    <Page
        id="page5"
        title="{i18n>title}"
        showHeader="false" 
    >
      
                <VBox id="vbox2"
                    renderType="Bare"
                    alignItems="Start"
                    height="100%"
                    width="100%"
                    class="sapUiTinyMarginEnd sapUiTinyMarginTop"
                >
                    <!-- <VBox> -->

                    <IconTabBar
                        id="idIconTabBarInlineMode"
                        headerMode="Inline"
                        expanded="{device>/isNoPhone}"
                    >
                        <items>
                            <IconTabFilter
                                text="Info"
                                key="info"
                                count="3"
                            >
                                <HBox class="sapUiTinyMarginBottom">
                                    <VBox>
                                        <Label text="Select Company" />
                                        <ComboBox
                                            id="customPrompSelectCompany"
                                            width="230px"
                                            class="sapUiSmallMarginEnd"
                                            items="{
                                    path: 'companyObjectsModel>/objectArray'}"
                                        >
                                            <core:Item
                                                key="{companyObjectsModel>ID}"
                                                text="{companyObjectsModel>COMPANY_NAME}"
                                            />
                                        </ComboBox>
                                    </VBox>

                                    <VBox>
                                        <Label text="Select Project" />
                                        <ComboBox
                                            width="230px"
                                            id="customPrompSelectProject"
                                            class="sapUiSmallMarginEnd"
                                            items="{
                                    path: 'customPromptProjectModel>/projectList'}"
                                        >
                                            <core:Item
                                                key="{customPromptProjectModel>ID}"
                                                text="{customPromptProjectModel>PROJECT_NAME}"
                                            />
                                        </ComboBox>
                                    </VBox>
                                </HBox>
                                <HBox
                                    width="100%"
                                    class="sapUiTinyMarginBottom"
                                >
                                    <TextArea
                                        id="promptText"
                                        class="sapUiTinyMarginEnd"
                                        placeholder="Enter your Custom Prompt"
                                        growing="true"
                                        growingMaxLines="10"
                                        width="60vw"
                                    />
                                    <Button
                                        text="Add Prompt"
                                        icon="sap-icon://save"
                                        type="Emphasized"
                                        press="onPressCustomPrompt"
                                    />
                                </HBox>
                                 <ScrollContainer
                                    height="400px"
                                    width="100%"
                                    vertical="true"
                                    focusable="true"
                                >
                                <Table
                                   id="infoTableCustomPrompt"
                                    mode="MultiSelect"
                                    items="{userPromptsModel>/userPromptArray}"
                                    sticky="ColumnHeaders,HeaderToolbar"
                                    inset="false"
                                    autoPopinMode="true"
                                >
                                    <headerToolbar>
                                        <OverflowToolbar
                                            class="tableHeaderToolbar"
                                        >
                                            <Title text="Custom Prompts" />
                                            <ToolbarSpacer />
                                            <Button
                                                text="Refresh"
                                                type="Ghost"
                                                press="onPressRefresh"
                                            />
                                            <Button
                                                text="Delete"
                                                type="Attention"
                                                icon="sap-icon://delete"
                                            />
                                            <SearchField
                                                liveChange="onSearchCustomPrompt1"
                                                width="17.5rem"
                                            />
                                        </OverflowToolbar>
                                    </headerToolbar>
                                    <columns>
                                        <Column>
                                            <Text text="Prompt" />
                                        </Column>
                                        <Column>
                                            <Text text="Created At" />
                                        </Column>
                                        <Column>
                                            <Text text="Created By" />
                                        </Column>
                                        <Column>
                                            <Text text="Status" />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <ExpandableText
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                    text="{userPromptsModel>PROMPT_STR}"
                                                    overflowMode="Popover"
                                                />
                                                <Text text="{userPromptsModel>createdAt}" />
                                                <Text text="{userPromptsModel>USER}" />
                                                <tnt:InfoLabel
                                                    text="Active"
                                                    colorScheme="8"
                                                />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                                </ScrollContainer>
                            </IconTabFilter>
                            <IconTabFilter
                                text="Try it Out"
                                key="tryItOut"
                            >
                                <ScrollContainer
                                    height="300px"
                                    width="100%"
                                    vertical="true"
                                    focusable="true"
                                >
                                    <Table
                                        id="selectPrompTrial"
                                        mode="MultiSelect"
                                        items="{userPromptsModel>/userPromptArray}"
                                        inset="false"
                                        autoPopinMode="true"
                                        sticky="HeaderToolbar"
                                    >
                                        <headerToolbar>
                                            <OverflowToolbar
                                                class="tableHeaderToolbar"
                                            >
                                                <Title text="Custom Prompts" />
                                                <ToolbarSpacer />
                                                <u:FileUploader
                                                    id="fileUploader"
                                                    name="myFileUpload"
                                                    uploadUrl="upload/"
                                                    directory="true"
                                                    change="onFileChange1"
                                                    multiple="true"
                                                    tooltip="Upload your file to the local server"
                                                    uploadComplete="handleUploadComplete"
                                                />
                                                <Button
                                                    text="Upload File"
                                                    type="Emphasized"
                                                    press="handleSingleUpload"
                                                />
                                                <SearchField
                                                    liveChange="onSearchCustomPrompt2"
                                                    width="17.5rem"
                                                />
                                            </OverflowToolbar>
                                        </headerToolbar>
                                        <columns>
                                            <Column>
                                                <Text text="Prompt" />
                                            </Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem>
                                                <cells>
                                                    <ExpandableText
                                                        class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                        text="{userPromptsModel>PROMPT_STR}"
                                                        overflowMode="Popover"
                                                    />
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </ScrollContainer>

                                <Panel
                                    width="100%"
                                    visible="true"
                                    expandable="true"
                                    expanded="false"
                                    headerText="Results"
                                    class="sapUiSmallMarginTop"
                                    id="singleTrialPanel"
                                >
                                     <content>
                            <VBox>
                                <HBox
                                    justifyContent="SpaceBetween"
                                    class="sapUiMediumMarginBottom"
                                >
                                    <VBox
                                        class="sapUiTinyMarginEnd"
                                        width="25%"
                                    >
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="OBJECT_NAME"
                                        />
                                        <Text
                                            text="{trialObjectModel>/OBJECT_NAME}"
                                        />
                                    </VBox>
                                    <VBox
                                        class="sapUiTinyMarginEnd"
                                        width="25%"
                                    >
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="SAP_MODULE_NAME"
                                        />
                                        <Text
                                            text="{trialObjectModel>/SAP_MODULE_NAME}"
                                        />
                                    </VBox>
                                    <VBox width="50%">
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="FUNCTIONAL_ANALYSIS"
                                        />
                                        <Text
                                            text="{trialObjectModel>/FUNCTIONAL_ANALYSIS}"
                                        />
                                    </VBox>
                                </HBox>
                                <HBox
                                    justifyContent="SpaceBetween"
                                    class="sapUiMediumMarginBottom"
                                >
                                    <VBox
                                        class="sapUiTinyMarginEnd"
                                        width="25%"
                                    >
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="Code Complexity"
                                        />
                                        <Text
                                            text="{trialObjectModel>/CODE_COMPLEXITY}"
                                        />
                                    </VBox>
                                    <VBox width="25%">
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="BDC_USED"
                                        />
                                        <Text
                                            visible="false"
                                            text="{trialObjectModel>/BDC_USED}"
                                        />
                                    </VBox>
                                    <VBox width="25%">
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="APPROACH"
                                        />
                                        <Text
                                            text="{trialObjectModel>/APPROACH}"
                                        />
                                    </VBox>
                                    <VBox width="25%">
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="PRIORITY"
                                        />
                                        <Text
                                            text="{trialObjectModel>/PRIORITY}"
                                        />
                                    </VBox>
                                </HBox>
                                <HBox
                                    justifyContent="SpaceBetween"
                                    class="sapUiMediumMarginBottom"
                                >
                                    <VBox
                                        class="sapUiTinyMarginEnd"
                                        width="25%"
                                    >
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="ADHERENCE"
                                        />
                                        <Text
                                            text="{trialObjectModel>/ADHERENCE}"
                                        />
                                    </VBox>
                                    <VBox width="25%">
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="TSHIRT"
                                        />
                                        <Text
                                            text="{trialObjectModel>/TSHIRT}"
                                        />
                                    </VBox>
                                    <VBox width="50%">
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="EFFORTS"
                                        />
                                        <Text
                                            text="{trialObjectModel>/EFFORTS}"
                                        />
                                    </VBox>
                                </HBox>
                                <HBox
                                    justifyContent="SpaceBetween"
                                    class="sapUiMediumMarginBottom"
                                >
                                    <VBox
                                        class="sapUiTinyMarginEnd"
                                        width="25%"
                                    >
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="SCREENS_USED "
                                        />
                                        <Text
                                            text="{trialObjectModel>/SCREENS_USED}"
                                        />
                                    </VBox>
                                    <VBox width="25%">
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="TOKEN_SIZE "
                                        />
                                        <Text
                                            text="{trialObjectModel>/TOKEN_SIZE}"
                                        />
                                    </VBox>
                                    <VBox width="50%">

                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="CLEAN_CORE_ANALYSIS"
                                        />
                                        <List
                                            items="{trialObjectModel>/CLEAN_CORE_ANALYSIS}"
                                            showNoData="true"
                                            noDataText="None"
                                        >
                                            <CustomListItem
                                                class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                            >
                                                <Text
                                                    text="{trialObjectModel>TITLE}: {trialObjectModel>DESCRIPTION}"
                                                    class="sapUiTinyMarginEnd"
                                                />
                                            </CustomListItem>
                                        </List>
                                    </VBox>
                                </HBox>
                                <HBox
                                    justifyContent="SpaceBetween"
                                    class="sapUiMediumMarginBottom"
                                >
                                    <VBox
                                        class="sapUiTinyMarginEnd"
                                        width="25%"
                                    >
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="UI_INTEGRATION"
                                        />
                                        <Text
                                            text="{trialObjectModel>/UI_INTEGRATION}"
                                        />
                                    </VBox>
                                    <VBox width="25%">
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="THIRD_PARTY_INTEGRATION"
                                        />
                                        <Text
                                            text="{trialObjectModel>/THIRD_PARTY_INTEGRATION}"
                                        />
                                    </VBox>
                                    <VBox width="50%">
                                        <tnt:InfoLabel
                                            colorScheme="6"
                                            text="S4_ANALYSIS"
                                        />
                                        <Text
                                            text="{trialObjectModel>/S4_ANALYSIS}"
                                        />
                                    </VBox>
                                </HBox>
                                <VBox justifyContent="Start">
                                    <HBox class="sapUiMediumMarginBottom">
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="WRICEF_OBJECT_TYPE"
                                            />
                                            <List
                                                items="{trialObjectModel>/WRICEF_OBJECT_TYPE}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <Text
                                                        text="{trialObjectModel>WRICEF_OBJECT_TYPE}"
                                                        class="sapUiTinyMarginEnd"
                                                    />
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="HIGH_LVL_RECOMMENDATIONS"
                                            />
                                            <List
                                                items="{trialObjectModel>/HIGH_LVL_RECOMMENDATIONS}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <Text
                                                        text="{trialObjectModel>Title} {trialObjectModel>Descripton}"
                                                        class="sapUiTinyMarginEnd"
                                                    />
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                    </HBox>
                                    <HBox class="sapUiMediumMarginBottom">
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="SAP BTP Services"
                                            />
                                            <List
                                                items="{trialObjectModel>/BTP_SERVICES}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <HBox>
                                                        <core:Icon
                                                            src="sap-icon://chevron-phase"
                                                            class="sapUiSmallMarginEnd"
                                                        />
                                                        <Text
                                                            text="{trialObjectModel>ServiceName}"
                                                            class="sapUiTinyMarginEnd"
                                                        />
                                                    </HBox>
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="READ_CRUD"
                                            />
                                            <List
                                                items="{trialObjectModel>/READ_CRUD}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <Text
                                                        text="{trialObjectModel>READ_CRUD}"
                                                        class="sapUiTinyMarginEnd"
                                                    />
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                    </HBox>
                                    <HBox class="sapUiSmallMarginBottom">
                                        <tnt:InfoLabel
                                            colorScheme="4"
                                            text="SQL ANALYSIS"
                                        />
                                    </HBox>
                                    <HBox class="sapUiMediumMarginBottom">
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="SQL_RECOMMENDATION"
                                            />
                                            <Text
                                                text="{trialObjectModel>/SQL_RECOMMENDATION}"
                                            />
                                        </VBox>
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="SQL_ANALYSIS_TABLES_DIRECT"
                                            />
                                            <List
                                                items="{trialObjectModel>/SQL_ANALYSIS_TABLES_DIRECT}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <Text
                                                        text="{trialObjectModel>TABLE_NAME}"
                                                        class="sapUiTinyMarginEnd"
                                                    />
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                    </HBox>
                                    <HBox class="sapUiMediumMarginBottom">
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="SQL_ANALYSIS_TABLES_API"
                                            />
                                            <List
                                                items="{trialObjectModel>/SQL_ANALYSIS_TABLES_API}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <Text
                                                        text="{trialObjectModel>SQL_ANALYSIS_TABLES_API}"
                                                        class="sapUiTinyMarginEnd"
                                                    />
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="SQL_ANALYSIS_TABLES_CDS"
                                            />
                                            <List
                                                items="{trialObjectModel>/SQL_ANALYSIS_TABLES_CDS}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <Text
                                                        text="{trialObjectModel>SQL_ANALYSIS_TABLES_CDS}"
                                                        class="sapUiTinyMarginEnd"
                                                    />
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                    </HBox>
                                    <HBox class="sapUiMediumMarginBottom">
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="INTEGERATION_RESULT"
                                            />
                                            <List
                                                items="{trialObjectModel>/INTEGERATION_RESULT}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <HBox>
                                                        <core:Icon
                                                            src="sap-icon://bo-strategy-management"
                                                            class="sapUiTinyMarginEnd"
                                                        />
                                                        <Text
                                                            text="{trialObjectModel>TITLE}"
                                                            class="sapUiTinyMarginEnd"
                                                        />
                                                    </HBox>
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="FUNCTION_MODULES"
                                            />
                                            <List
                                                items="{trialObjectModel>/FUNCTION_MODULES}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <Text
                                                        text="{trialObjectModel>FUNCTION_MODULES}"
                                                        class="sapUiTinyMarginEnd"
                                                    />
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                    </HBox>

                                    <HBox class="sapUiMediumMarginBottom">
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="CUSTOM TABLES"
                                            />
                                            <List
                                                items="{trialObjectModel>/CUSTOM_TABLES}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <Text
                                                        text="{trialObjectModel>TABLE_NAME}"
                                                        class="sapUiTinyMarginEnd"
                                                    />
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="STANDARD_TABLES"
                                            />
                                            <List
                                                items="{trialObjectModel>/STANDARD_TABLES}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <HBox>
                                                        <core:Icon
                                                            src="sap-icon://table-view"
                                                            class="sapUiTinyMarginEnd"
                                                        />
                                                        <Text
                                                            text="{trialObjectModel>TABLE_NAME}"
                                                            class="sapUiTinyMarginEnd"
                                                        />
                                                    </HBox>
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                    </HBox>
                                    <HBox class="sapUiMediumMarginBottom">
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="BAPIS"
                                            />
                                            <List
                                                items="{trialObjectModel>/BAPIS}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <Text
                                                        text="{trialObjectModel>BAPIS}"
                                                        class="sapUiTinyMarginEnd"
                                                    />
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                        <VBox
                                            class="sapUiSmallMarginBottom"
                                            width="50%"
                                        >
                                            <tnt:InfoLabel
                                                colorScheme="6"
                                                text="NEW_S4_TABLES"
                                            />
                                            <List
                                                items="{trialObjectModel>/NEW_S4_TABLES}"
                                                showNoData="true"
                                                noDataText="None"
                                            >
                                                <CustomListItem
                                                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                                                >
                                                    <HBox>
                                                        <core:Icon
                                                            src="sap-icon://table-view"
                                                            class="sapUiTinyMarginEnd"
                                                        />
                                                        <Text
                                                            text="{trialObjectModel>S4_TABLES}"
                                                            class="sapUiTinyMarginEnd"
                                                        />
                                                    </HBox>
                                                </CustomListItem>
                                            </List>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                                </Panel>
                            </IconTabFilter>
                        </items>
                    </IconTabBar>
                </VBox>
          
       
    </Page>
</mvc:View>
