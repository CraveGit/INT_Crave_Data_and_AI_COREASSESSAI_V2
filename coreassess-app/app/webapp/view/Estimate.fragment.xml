<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:m="sap.m"
    xmlns:tnt="sap.tnt"
>
    <Dialog
        id="estimateFrag"
        resizable="true"
        draggable="true"
        title=""
        contentWidth="auto"
        contentHeight="auto"
        titleAlignment="Center"
    >
        <VBox class="sapUiResponsiveMargin">
            <tnt:InfoLabel text="Select type of development to estimate"   colorScheme="7"/>
            <MultiComboBox
                showSelectAll="false" selectionChange="onSelectEstimate"
                id="estimateCombo" width="500px"
            >
                <core:Item
                    key="application"
                    text="Application Development"
                />
                <core:Item
                    key="automation"
                    text="Automation"
                />
                
            </MultiComboBox>

           
            <tnt:InfoLabel
                text="Automation" id="automationIDinfo" visible="false"
                colorScheme="7"
                class="sapUiTinyMarginTop sapUiTinyMarginBottom"
            />
            <List
                items="{estimateQuestionModel>/questionArray/automation}" visible="false"
                id="automationID"
                showNoData="true"
                noDataText="  "
            >
                <CustomListItem
                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                >
                    <HBox justifyContent="SpaceBetween">
                        <HBox class="sapUiSmallMarginEnd">
                            <core:Icon
                                src="sap-icon://sys-help"
                                class="sapUiTinyMarginEnd"
                            />
                            <Text
                                text="{estimateQuestionModel>question}"
                                class="sapUiTinyMarginEnd" wrapping="true"
                            />
                        </HBox>
                        <HBox>
                            <Input
                                value="{estimateQuestionModel>answer}"
                                width="300px" 
                                class="sapUiTinyMarginEnd" placeholder="{estimateQuestionModel>palceholder}"
                            />
                        </HBox>
                    </HBox>
                </CustomListItem>
            </List>


              <tnt:InfoLabel
                text="Application Development" id="applicationIDinfo" visible="false"
                colorScheme="7"
                class="sapUiTinyMarginTop sapUiTinyMarginBottom"
            />
            <List
                items="{estimateQuestionModel>/questionArray/application}" visible="false"
                id="applicationID"
                showNoData="true"
                noDataText="  "
            >
                <CustomListItem
                    class="sapUiTinyMarginBottom sapUiTinyMarginTop"
                >
                    <HBox justifyContent="SpaceBetween">
                        <HBox class="sapUiSmallMarginEnd">
