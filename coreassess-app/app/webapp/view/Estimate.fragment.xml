<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:m="sap.m"
    xmlns:tnt="sap.tnt"
>
    <Dialog
        id="estimateFrag"
        resizable="true"
        draggable="true"
        title=""
        contentWidth="620px"
        contentHeight="auto"
        titleAlignment="Center"
    >
        <VBox class="sapUiResponsiveMargin">
            <tnt:InfoLabel
                text="Answer these to size the BTP services for this object"
                colorScheme="7"
                class="sapUiSmallMarginBottom"
            />
            <!-- Questions are prebaked per object by the AI (context-aware, tagged with the
                 BTP service each one sizes). No pricing is shown here. -->
            <List
                items="{estimateQuestionModel>/questions}"
                id="estimateQuestionsList"
                showNoData="true"
                noDataText="No sizing questions were generated for this object."
                showSeparators="Inner"
            >
                <CustomListItem class="sapUiTinyMarginBottom sapUiTinyMarginTop">
                    <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                        <VBox class="sapUiSmallMarginEnd" width="100%">
                            <tnt:InfoLabel
                                text="{estimateQuestionModel>scope}"
                                colorScheme="6"
                                renderMode="Narrow"
                                class="craScopeTag sapUiTinyMarginBottom"
                                visible="{= !!${estimateQuestionModel>scope} }"
                            />
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://sys-help" class="sapUiTinyMarginEnd"/>
                                <Text text="{estimateQuestionModel>question}" wrapping="true"/>
                            </HBox>
                        </VBox>
                        <Input
                            value="{estimateQuestionModel>answer}"
                            type="Number"
                            width="140px"
                            placeholder="{estimateQuestionModel>palceholder}"
                        />
                    </HBox>
                </CustomListItem>
            </List>
        </VBox>
        <footer>
            <m:OverflowToolbar>
                <m:ToolbarSpacer />
                <Button
                    press="onEstimate"
                    type="Accept"
                    text="Save"
                    class="sapUiTinyMarginEnd"
                />
                <Button
                    press="estimateFragClose"
                    text="Close"
                />
            </m:OverflowToolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>
