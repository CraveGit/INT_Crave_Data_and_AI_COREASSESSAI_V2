                            />
                        </HBox>
                        <HBox>
                            <Input
                                value="{estimateQuestionModel>answer}"
                                width="300px" 
                                class="sapUiTinyMarginEnd" placeholder="{estimateQuestionModel>palceholder}"
                            />
                        </HBox>
                    </HBox>
                </CustomListItem>
            </List>

