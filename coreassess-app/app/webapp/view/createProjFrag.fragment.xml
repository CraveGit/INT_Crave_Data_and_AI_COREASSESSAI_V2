<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:m="sap.m"
    xmlns:tnt="sap.tnt"
>
    <Dialog
        id="createProjFrag"
        resizable="true"
        draggable="true"
        title="Create Project"
        contentWidth="auto"
        contentHeight="auto"
        titleAlignment="Center"
    >     
    	<VBox class="sapUiSmallMargin">
		<f:SimpleForm 
			editable="true"
			layout="ResponsiveGridLayout"
			
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content>
				<Label text="Name of Company" />
				<Input editable="false" value="{dataModel>/companyData/COMPANY_NAME}" />
                <Label text="Project Name" />
				<Input id="projName" value="{SupplierName}" />
				 <Label text="Skill Set" />
                 	<ComboBox
				items="{skillSetModel>/skillsetarray}" id="skillSetCreate">
				<core:Item key="{skillSetModel>ID}" text="{skillSetModel>Name}" />
			</ComboBox>
			</f:content>
		</f:SimpleForm></VBox>
       <footer>
            <m:OverflowToolbar>
                <m:ToolbarSpacer />
                <Button
                    press="onCreateProj"
                    type="Accept"
                    text="Create"
                    class="sapUiTinyMarginEnd"
                />
                <Button
                    press="createProjFragClose"
                    text="Close"
                />
            </m:OverflowToolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>