<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Popover id="uploadJobPopover" title="Analysing objects" placement="Bottom"
        contentWidth="26rem" class="craUploadJobPopover">
        <VBox class="sapUiSmallMargin">
            <!-- Warn while running: this analysis lives in the browser tab. -->
            <MessageStrip
                text="Analysis runs in the background here. Reloading or closing the tab will stop it."
                type="Warning" showIcon="true"
                visible="{= ${foldersModel>/running} === true }"
                class="sapUiTinyMarginBottom"/>
            <ProgressIndicator
                percentValue="{foldersModel>/progressPercent}"
                displayValue="{foldersModel>/progressText}"
                showValue="true"
                state="Information"
                class="sapUiSmallMarginBottom sapUiTinyMarginTop"/>
            <!-- Same compact table style as the "Analysing objects" dialog
                 (UploadProgress.fragment) so the job-card rows aren't oversized. -->
            <Table items="{foldersModel>/folderArray}" class="craGridTable craUploadTable"
                sticky="ColumnHeaders" growing="true" growingThreshold="50" noDataText="No objects">
                <columns>
                    <Column><Text text="Object"/></Column>
                    <Column width="7rem" hAlign="End"><Text text="Status"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier title="{foldersModel>webkitRelativePath}" text="{foldersModel>statusNote}"/>
                            <ObjectStatus
                                text="{foldersModel>status}"
                                state="{path:'foldersModel>status', formatter:'.formatUploadStatusState'}"
                                icon="{path:'foldersModel>status', formatter:'.formatUploadStatusIcon'}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button text="Cancel analysis" type="Reject" icon="sap-icon://cancel"
                    press="onCancelUploadJobs"
                    visible="{= ${foldersModel>/running} === true &amp;&amp; ${foldersModel>/cancelled} !== true &amp;&amp; ${foldersModel>/pendingCount} &gt; 0 }"/>
                <Button text="Dismiss" type="Emphasized" press="onCloseUploadJobs"
                    visible="{= ${foldersModel>/running} !== true }"/>
            </OverflowToolbar>
        </footer>
    </Popover>
</core:FragmentDefinition>
