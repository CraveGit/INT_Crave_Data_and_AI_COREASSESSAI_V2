entity LLMChatHistory {
  key ID : Integer;
  assessmentID: String(100);
  projectID: String(100);
  docType: String(100);
  user: String(100);
  prompt: String(400);
  response: LargeString;
  upvotes: Integer;
  downvotes: Integer;
