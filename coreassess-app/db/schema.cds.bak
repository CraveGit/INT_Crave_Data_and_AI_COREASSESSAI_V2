namespace KCC_prod;

using {managed} from '@sap/cds/common';

entity MSTR_USER : managed {
  key ID           : Integer;
      USERNAME     : String;
      ROLE         : String;
      COMPANY      : Association to MSTR_COMPANY;
      LICENSE_ROLE : String;
      ALLOWEDOBJECTS: Integer;
      UPLOADEDOBJECTS: Integer;
      LicenseRoles : Composition of many MSTR_USER_LICENSE
                       on LicenseRoles.USER_ID = $self;
}

entity MSTR_USER_LICENSE : managed {
  key ID             : Integer;
      USER_ID        : Association to MSTR_USER;
      RoleType       : String; // superuser, limiteduser
      AssignedAt     : DateTime;
      RemainingCount : Integer;
      TotalCount     : Integer;
      COMPANY_ID     : Association to MSTR_COMPANY;
}

// entity MSTR_LICENSE_PLAN : managed


entity MSTR_COMPANY : managed {
  key ID           : Integer;
      COMPANY_NAME : String(100);
      IMAGE_URL    : String;
}

entity MSTR_PROJECT : managed {
  key ID            : Integer;
  key COMPANY       : Association to MSTR_COMPANY;
      PROJECT_NAME  : String(100);
      SkillSet      : Association to SkillSet;
      ACTIVE_STATUS : Boolean default true;
}

entity COMPANY_USER_MAP {
  key USERNAME   : String;
  key COMPANY_ID : Integer;
}

// Graph 1 -> SAP_MODULE_NAME

entity READ_CRUD {
  key ID        : UUID;
      ASSESMENT : Association to ASSESMENT;
      READ_CRUD : String;
}

entity ASSESMENT : managed {
  key ID                         : Integer;
      PROJECT                    : Association to MSTR_PROJECT;
      OBJECT_NAME                : String(400);
      BDC_USED                   : Integer; // new
      PRIORITY                   : String; // new
      READ_CRUD                  : Composition of many READ_CRUD
                                     on READ_CRUD.ASSESMENT = $self;
      SAP_MODULE_NAME            : String(400);
      CLEAN_CORE_ANALYSIS        : Composition of many CLEAN_CORE_ANALYSIS
                                     on CLEAN_CORE_ANALYSIS.ASSESMENT = $self;
      FUNCTIONAL_ANALYSIS        : String;
      TShirt                     : String;
      Efforts                    : Integer;
      WRICEF_OBJECT_TYPE         : Composition of many WRICEF_TYPES
                                     on WRICEF_OBJECT_TYPE.ASSESMENT_ID = $self;
      HIGH_LVL_RECOMMENDATIONS   : Composition of many ASSESSMENT_RECOMMENDATIONS
                                     on HIGH_LVL_RECOMMENDATIONS.ASSESSMENT = $self;
      CODE_COMPLEXITY            : String;
      STANDARD_TABLES            : Composition of many ASSESSMENT_STANDARD_TABLES
                                     on STANDARD_TABLES.ASSESMENT = $self;
      CUSTOM_TABLES              : Composition of many ASSESSMENT_CUSTOM_TABLES
                                     on CUSTOM_TABLES.ASSESMENT = $self;
      NEW_S4_TABLES              : Composition of many NEW_S4_TABLES
                                     on NEW_S4_TABLES.ASSESMENT = $self;
      SQL_ANALYSIS_TABLES_API    : Composition of many SQL_ANALYSIS_TABLES_API
                                     on SQL_ANALYSIS_TABLES_API.ASSESMENT = $self;
      SQL_ANALYSIS_TABLES_CDS    : Composition of many SQL_ANALYSIS_TABLES_CDS
                                     on SQL_ANALYSIS_TABLES_CDS.ASSESMENT = $self;
      COUPLING                   : String(20);
      SQL_ANALYSIS_TABLES_DIRECT : Composition of many SQL_ANALYSIS_TABLES_DIRECT
                                     on SQL_ANALYSIS_TABLES_DIRECT.ASSESMENT = $self;
      SQL_RECOMMENDATION         : String;
      APPROACH                   : String;
      BTP_SERVICES               : Composition of many BTP_SERVICES
                                     on BTP_SERVICES.ASSESMENT_ID = $self;
      ADHERENCE                  : String;
      BTP_SERVICES_SEARCH        : String;
      TOKEN_SIZE                 : Integer;
      CODELENGTH                 : String;
      DEVELOPMENTAPPROACH        : String;
      SCREENS_USED               : Integer;
      BAPIS                      : Composition of many BAPIS
                                     on BAPIS.ASSESMENT = $self;
      FUNCTION_MODULES           : Composition of many FUNCTION_MODULES
                                     on FUNCTION_MODULES.ASSESMENT = $self;
      S4_ANALYSIS                : String;
      S4_RECOMMENDATIONS         : Composition of many S4_RECOMMENDATIONS
                                     on S4_RECOMMENDATIONS.ASSESMENT = $self;
      UI_INTEGRATION             : String;
      THIRD_PARTY_INTEGRATION    : String;
      INTEGERATION_RESULT        : Composition of many INTEGERATION_RESULT
                                     on INTEGERATION_RESULT.ASSESMENT = $self;
      INTERFACE_IDOCS            : Composition of many INTERFACE_IDOCS
                                     on INTERFACE_IDOCS.ASSESMENT = $self;
      INTERFACE_STANDARD_API     : Composition of many INTERFACE_STANDARD_API
                                     on INTERFACE_STANDARD_API.ASSESMENT = $self;

      USE_CASE_AREA              : Composition of many USE_CASE_AREA
                                     on USE_CASE_AREA.ASSESMENT = $self;
      EVENTS                     : Composition of many EVENTS
                                     on EVENTS.ASSESMENT = $self;
      STANDARD_EVENTS            : Composition of many STANDARD_EVENTS
                                     on STANDARD_EVENTS.ASSESMENT = $self;
      TOPICS                     : Composition of many TOPICS
                                     on TOPICS.ASSESMENT = $self;
      USE_CASE_AREA_EXPLANATION  : String;
      INTEGRATION_MODERNIZATION  : String;
      SAP_SUB_MODULE             : String;
      RAW_ANALYSIS               : LargeString;
      IS_ESTIMATED               : Boolean default false;
      SAP_STANDARD_API           : Composition of many USE_CASE_AREA
                                     on SAP_STANDARD_API.ASSESMENT = $self;
      SAP_STANDARD_FIORI_APP     : Composition of many USE_CASE_AREA
                                     on SAP_STANDARD_FIORI_APP.ASSESMENT = $self;
      AUTHORIZATION_CHECK        : Composition of many AUTHORIZATION_CHECK
                                     on AUTHORIZATION_CHECK.ASSESSMENT = $self;
      IDENTIFIER                 : String(20);
      RETIRE_EXPLAINATION        : String;
      REIMPLEMENTATION           : String;
      CODEQUALITYSCORE           : String;
      CODEQUALITYSCORERATIO      : String;
      CRITICALITY                : String;
      USAGECONTEXT               : String;
      CODEREFERENCE              : String;
      DETAILEDBREAKDOWN          : LargeString;
      SCOREANALYSIS              : LargeString;
      FIELD_VALUES               : Composition of many FIELD_VALUES
                                     on FIELD_VALUES.ASSESSMENT = $self;
}

entity FIELD_VALUES : managed {
  key ID         : UUID;
      ACTVT      : String;
      OBTYP      : String;
      STSMA      : String;
      BERSL      : String;
      ASSESSMENT : Association to ASSESMENT;
}

entity AUTHORIZATION_CHECK : managed {
  key ID            : UUID;
      AUTHOBJECT    : String;
      FIELDSCHECKED : String;
      CHECKTYPE     : String;
      CODEREFERENCE : String;
      ASSESSMENT    : Association to ASSESMENT;
}

// entity FIELDSCHECKED {
